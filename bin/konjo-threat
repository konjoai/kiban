#!/usr/bin/env python3
"""konjo-threat: trust-boundary classifier and brief-time threat-model record.

  konjo-threat classify --files F [F ...] [--diff PATH]
      Emit a heuristic hint of which trust boundaries this change plausibly touches:
      {"boundaries": [...], "reasons": {boundary: [...]}}. Advisory only. Exit 0.

  konjo-threat record --files F [F ...] --boundary NAME --mitigation TEXT
                       --abuse-case TEXT [--boundary NAME --mitigation TEXT
                       --abuse-case TEXT ...] [--author NAME]
      Record a threat model: one --boundary/--mitigation/--abuse-case triple per
      boundary hit (repeat the flag group). Pass no --boundary at all to record "no
      boundaries apply" -- a valid, explicit answer. Refuses (exit 4) any boundary name
      outside the fixed taxonomy or any empty mitigation/abuse case. Logs to the Ledger
      and prints the commit trailer CI checks for. Exit 0 on success.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys

_KIBAN_ROOT = pathlib.Path(__file__).resolve().parent.parent
if str(_KIBAN_ROOT) not in sys.path:
    sys.path.insert(0, str(_KIBAN_ROOT))

from lib import threat  # noqa: E402


def _read_diff(path: str | None) -> str:
    if not path:
        return ""
    if path == "-":
        return sys.stdin.read()
    return pathlib.Path(path).read_text(encoding="utf-8")


def _parse_triples(args: argparse.Namespace) -> list[threat.BoundaryRecord]:
    boundaries = args.boundary or []
    mitigations = args.mitigation or []
    abuse_cases = args.abuse_case or []
    if not (len(boundaries) == len(mitigations) == len(abuse_cases)):
        raise SystemExit(
            "konjo-threat: --boundary, --mitigation, and --abuse-case must repeat in "
            "matched triples (same count of each)"
        )
    return [
        threat.BoundaryRecord(boundary=b, mitigation=m, abuse_case=a)
        for b, m, a in zip(boundaries, mitigations, abuse_cases)
    ]


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="konjo-threat")
    sub = parser.add_subparsers(dest="cmd", required=True)

    classify_p = sub.add_parser("classify")
    classify_p.add_argument("--files", nargs="+", required=True)
    classify_p.add_argument("--diff", default=None, help="path to a diff, or - for stdin")

    record_p = sub.add_parser("record")
    record_p.add_argument("--files", nargs="+", required=True)
    record_p.add_argument("--boundary", action="append", default=[])
    record_p.add_argument("--mitigation", action="append", default=[])
    record_p.add_argument("--abuse-case", action="append", default=[])
    record_p.add_argument("--author", default="unknown")

    args = parser.parse_args(argv)

    if args.cmd == "classify":
        diff_text = _read_diff(args.diff)
        cls = threat.classify(args.files, diff_text)
        print(json.dumps({"boundaries": cls.boundaries, "reasons": cls.reasons}))
        return 0

    # record
    try:
        records = _parse_triples(args)
    except SystemExit as exc:
        print(str(exc), file=sys.stderr)
        return 4

    try:
        from ledger.engine import Ledger
        trailer = threat.record_threat_model(
            args.files, records, author=args.author, ledger=Ledger()
        )
    except threat.MissingContent as exc:
        print(f"konjo-threat: refused: {exc}", file=sys.stderr)
        return 4

    print("Recorded. Add this trailer to the commit so CI can see it:")
    print(f"  {trailer}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
