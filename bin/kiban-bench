#!/usr/bin/env python3
"""kiban-bench: one-shot baseline measurement, per repo.

  kiban-bench run --repo /path/to/lopi [--repo /path/to/squish ...]
              [--out DIR] [--mutation-timeout SECONDS]

Runs each target repo's own coverage and mutation tools (cargo-llvm-cov + cargo-mutants
for Rust, pytest-cov + mutmut for Python; see `lib/bench.py` for why not tarpaulin), plus
test count/wall-clock and clean-build wall-clock, records the toolchain versions and exact
commit SHA measured, writes a dated JSON artifact per repo, and appends a compact record to
`bench/<repo>-bench.jsonl` (the jsonl_store substrate, not the Decision Ledger -- see
`lib/bench.py` module docstring).

Full-repo mutation testing is slow (README: "plausibly hours" on a large Rust workspace).
`--mutation-timeout` bounds it; a timed-out run still scores whatever mutants completed and
says so explicitly in `mutation_notes`, rather than silently reporting a full-looking number.
"""

from __future__ import annotations

import argparse
import pathlib
import sys

_KIBAN_ROOT = pathlib.Path(__file__).resolve().parent.parent
if str(_KIBAN_ROOT) not in sys.path:
    sys.path.insert(0, str(_KIBAN_ROOT))

from lib import bench  # noqa: E402


def cmd_run(args: argparse.Namespace) -> int:
    out_dir = pathlib.Path(args.out)
    exit_code = 0
    for repo_str in args.repo:
        repo = pathlib.Path(repo_str)
        if not repo.exists():
            print(f"kiban-bench: {repo} does not exist, skipping", file=sys.stderr)
            exit_code = 1
            continue
        print(f"kiban-bench: running against {repo} ...")
        try:
            result = bench.run_bench(repo, mutation_timeout_s=args.mutation_timeout)
        except bench.BenchError as exc:
            print(f"kiban-bench: {repo}: {exc}", file=sys.stderr)
            exit_code = 1
            continue
        artifact = bench.write_artifact(result, out_dir)
        ledger_path = bench.record_to_ledger(result, artifact)
        print(f"  sha={result.sha[:12]} kind={result.repo_kind}")
        print(f"  clean_build={result.clean_build_wall_s}s test_count={result.test_count} "
              f"test_wall={result.test_wall_s}s")
        print(f"  coverage={result.coverage_line_pct}% ({result.coverage_tool})")
        print(f"  mutation={result.mutation_score_pct}% "
              f"(caught={result.mutation_caught} missed={result.mutation_missed}) "
              f"({result.mutation_tool}, {result.mutation_wall_s}s)")
        if result.errors:
            print(f"  errors: {result.errors}")
        print(f"  artifact -> {artifact}")
        print(f"  ledger   -> {ledger_path}")
    return exit_code


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="kiban-bench")
    sub = parser.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="run the one-shot baseline against one or more repos")
    r.add_argument("--repo", action="append", required=True, help="path to target repo (repeatable)")
    r.add_argument("--out", default=str(bench.RESULTS_DIR), help="results directory")
    r.add_argument("--mutation-timeout", type=int, default=1800,
                    help="seconds to allow the full-repo mutation run before scoring partial results")
    r.set_defaults(func=cmd_run)

    args = parser.parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
