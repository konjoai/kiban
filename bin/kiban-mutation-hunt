#!/usr/bin/env python3
"""kiban-mutation-hunt: the surviving-mutant -> assertion loop (review-pipeline
Sprint P2b, section 3), packaged as a real CLI call site for the
`konjo/mutation-hunt` skill (section 4) -- a skill file with no real caller is not a
shipped feature (Sprint S13's rule), and this is that caller.

  kiban-mutation-hunt run --repo /path/to/repo --base-ref HEAD --lcov lcov.info
                       [--path-prefix crates/lopi-ratelimit/] [--crate lopi-ratelimit]
                       [--round-cap 3] [--token-ceiling 150000] [--model NAME]
                       [--out DIR] [--commit-messages FILE]

Coverage (lcov, already generated by the caller -- this tool does not run
`cargo llvm-cov` itself, matching `kiban bench`'s own division of labor) -> ranked
uncovered items -> a real headless model session writes tests -> `cargo mutants
--in-diff` -> feedback -> loop. Exits 0 iff the gate passes (zero surviving mutants,
or an existing `Konjo-Mutation-Waived` trailer covering the exact survivor set);
exits 1 otherwise, so a CI call site can act on the result without parsing prose.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys
from dataclasses import asdict

_KIBAN_ROOT = pathlib.Path(__file__).resolve().parent.parent
if str(_KIBAN_ROOT) not in sys.path:
    sys.path.insert(0, str(_KIBAN_ROOT))

from lib import mutation_hunt_loop as mhl  # noqa: E402
from lib import uncovered_items  # noqa: E402


def _uncovered_by_file(lcov_path: pathlib.Path, repo: pathlib.Path, path_prefix: str | None) -> dict[str, set[int]]:
    by_file = uncovered_items.parse_lcov(lcov_path.read_text(encoding="utf-8"))
    by_file = uncovered_items.relativize(by_file, repo)
    if path_prefix:
        by_file = {f: lines for f, lines in by_file.items() if f.startswith(path_prefix)}
    return by_file


def cmd_run(args: argparse.Namespace) -> int:
    repo = pathlib.Path(args.repo)
    ast_diff_bin = uncovered_items.find_ast_diff_bin(_KIBAN_ROOT)
    if ast_diff_bin is None:
        print(
            "kiban-mutation-hunt: konjo-ast-diff binary not built -- run "
            "`cargo build --release` in packages/konjo-ast-diff-rs first",
            file=sys.stderr,
        )
        return 2

    uncovered_by_file = _uncovered_by_file(pathlib.Path(args.lcov), repo, args.path_prefix)
    if not uncovered_by_file:
        print("kiban-mutation-hunt: no uncovered lines found in scope, nothing to do")
        return 0

    commit_messages = ""
    if args.commit_messages:
        commit_messages = pathlib.Path(args.commit_messages).read_text(encoding="utf-8")

    try:
        result = mhl.run_mutation_hunt_loop(
            repo,
            args.base_ref,
            uncovered_by_file=uncovered_by_file,
            ast_diff_binary=ast_diff_bin,
            diff_base_ref=args.diff_base_ref,
            crate=args.crate,
            round_cap=args.round_cap,
            token_ceiling_per_round=args.token_ceiling,
            model=args.model,
            keep_worktree=args.keep_worktree,
            commit_messages_for_waiver_check=commit_messages,
        )
    except mhl.MutationHuntError as exc:
        print(f"kiban-mutation-hunt: {exc}", file=sys.stderr)
        return 2

    print(f"terminated: {result.terminated_reason}  gate_pass: {result.gate_pass}")
    for r in result.rounds:
        killed = r.mutants_killed if r.mutants_killed is not None else "n/a"
        tokens = (r.tokens_input or 0) + (r.tokens_output or 0)
        clean = "ok" if (r.clean_tree is None or r.clean_tree.ok) else f"FAILED ({len(r.clean_tree.failed_tests)} tests)"
        print(
            f"  round {r.round_num} [{r.prompt_kind}]: surviving={r.surviving_count_after} "
            f"killed={killed} truncated={r.truncated} tokens={tokens} "
            f"cost=${r.cost_usd or 0:.4f} clean_tree={clean}"
        )
    print(f"total_tokens: {result.total_tokens}  clean_tree_failures: {result.clean_tree_failure_count}")
    if result.waiver_trailer_suggestion:
        print(f"gate FAILED -- add this trailer to waive, with a real reason:\n  {result.waiver_trailer_suggestion}")

    if args.out:
        out_dir = pathlib.Path(args.out)
        out_dir.mkdir(parents=True, exist_ok=True)
        artifact = {
            "terminated_reason": result.terminated_reason,
            "gate_pass": result.gate_pass,
            "waiver_trailer_suggestion": result.waiver_trailer_suggestion,
            "total_tokens": result.total_tokens,
            "clean_tree_failure_count": result.clean_tree_failure_count,
            "rounds": [
                {**asdict(r), "mutants_killed": r.mutants_killed} for r in result.rounds
            ],
        }
        (out_dir / "mutation_hunt_result.json").write_text(json.dumps(artifact, indent=2, default=str))
        print(f"artifact -> {out_dir / 'mutation_hunt_result.json'}")

    return 0 if result.gate_pass else 1


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="kiban-mutation-hunt")
    sub = parser.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="run the mutation-hunt loop against one repo")
    r.add_argument("--repo", required=True, help="path to target repo")
    r.add_argument("--base-ref", required=True, help="commit-ish to check the worktree out at (e.g. the PR's own HEAD)")
    r.add_argument(
        "--diff-base-ref", default=None,
        help="ref cargo-mutants --in-diff scopes against (e.g. the PR's target branch); "
             "defaults to --base-ref if omitted, which only works when the production "
             "change under test is NOT already present at --base-ref",
    )
    r.add_argument("--lcov", required=True, help="path to an lcov.info coverage report")
    r.add_argument("--path-prefix", default=None, help="only consider uncovered files under this prefix")
    r.add_argument("--crate", default=None, help="cargo -p scope for test/mutants runs")
    r.add_argument("--round-cap", type=int, default=mhl.DEFAULT_ROUND_CAP)
    r.add_argument("--token-ceiling", type=int, default=mhl.DEFAULT_TOKEN_CEILING_PER_ROUND)
    r.add_argument("--model", default=None)
    r.add_argument("--out", default=None, help="directory to write a JSON result artifact")
    r.add_argument("--keep-worktree", action="store_true", help="do not clean up the worktree (debugging)")
    r.add_argument("--commit-messages", default=None, help="file of commit messages to check for an existing waiver trailer")
    r.set_defaults(func=cmd_run)

    args = parser.parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
