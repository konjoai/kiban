#!/usr/bin/env python3
"""konjo-eval: the meta-gate eval harness CLI.

Runs the real review gate (lib/review.review_diff) against the planted-bug corpus and
checks each fixture against its expectation. Records per-run detection plus the
aggregate; never reports a single-run detection rate as final. Exits nonzero on any
missed CRITICAL bug or any control that fired.

`gen` runs the Phase 13 generation-fixture corpus instead: classifies each recorded
`candidate.diff` against the eight-class defect taxonomy and reports per-class counts.
Report-only -- always exits 0, since a generation-quality count is noisy by nature and
this command never gates a merge (see `.konjo/killtests/P13/KT-13.1.md`).

`genrun` is Phase 14, Phase 1: drives the real task-to-diff loop (`lib.gen_runner`)
against a task spec file, `--runs` times per task, classifies each resulting diff, and
optionally saves each run as a permanent fixture under `--out-dir`. This is the only
subcommand that makes real model calls by default (there is no baseline cassette for a
task the harness has never run) -- pass `--record` to also capture a cassette so a CI
replay can reproduce the same result offline later.

Usage:
  konjo-eval [run] [--profile profiles/squish.yml] [--runs 3] [--mode daily|deep]
             [--json] [--corpus DIR]
  konjo-eval gen [--corpus evals/gen_fixtures] [--json]
  konjo-eval genrun --tasks TASKS.json [--context-file CTX.txt] [--runs 3]
             [--model M] [--out-dir DIR] [--replay] [--record] [--json]
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys

_KIBAN_ROOT = pathlib.Path(__file__).resolve().parent.parent
if str(_KIBAN_ROOT) not in sys.path:
    sys.path.insert(0, str(_KIBAN_ROOT))

from evals import cassettes, gen_cassettes, genfixtures, runner  # noqa: E402
from lib.gen_runner import GenerationBackend, GenTask, LiveGenerationBackend  # noqa: E402
from lib.review import ReviewBackend  # noqa: E402


def _run_genrun(args: argparse.Namespace) -> int:
    tasks_data = json.loads(pathlib.Path(args.tasks).read_text())
    context_text = pathlib.Path(args.context_file).read_text() if args.context_file else ""

    use_replay = args.replay and not args.record
    backend: GenerationBackend = (
        gen_cassettes.ReplayGenBackend(gen_cassettes.load_gen_cassettes())
        if use_replay
        else LiveGenerationBackend()
    )
    if args.record:
        backend = gen_cassettes.RecordingGenBackend(backend)

    out_dir = pathlib.Path(args.out_dir) if args.out_dir else None
    results: list[dict] = []
    for t in tasks_data:
        base_task = GenTask(
            id=t["id"],
            prompt=t["prompt"],
            context_label=t.get("context_label", "baseline"),
            source=t.get("source", "unknown"),
            repo=t["repo"],
            base_ref=t["base_ref"],
        )
        for run_idx in range(1, args.runs + 1):
            run_task = (
                base_task
                if args.runs == 1
                else GenTask(
                    id=f"{base_task.id}-run{run_idx}",
                    prompt=base_task.prompt,
                    context_label=base_task.context_label,
                    source=base_task.source,
                    repo=base_task.repo,
                    base_ref=base_task.base_ref,
                )
            )
            result = backend.generate(run_task, context_text, model=args.model)
            classification = genfixtures.classify_diff(result.diff_text, result.changed_paths)
            counts = {c: classification.count(c) for c in genfixtures.DEFECT_TAXONOMY}
            duration = round(result.duration_s, 1)
            row = {
                "task_id": run_task.id,
                "ok": result.ok,
                "returncode": result.returncode,
                "duration_s": duration,
                "counts": counts,
            }
            results.append(row)
            if not args.json:
                counts_str = (
                    ", ".join(f"{c}={n}" for c, n in counts.items() if n)
                    or "no mechanically-classified findings"
                )
                print(
                    f"  [{'OK' if result.ok else 'FAIL'}] {run_task.id} ({duration}s): {counts_str}"
                )
            if out_dir is not None and result.ok:
                genfixtures.save_gen_fixture(
                    fixture_id=run_task.id,
                    prompt=run_task.prompt,
                    context_label=run_task.context_label,
                    source=run_task.source,
                    diff_text=result.diff_text,
                    fixtures_dir=out_dir,
                )

    if args.record and isinstance(backend, gen_cassettes.RecordingGenBackend):
        cassette_path = gen_cassettes.save_gen_cassette(pathlib.Path(args.tasks).stem, backend.data)
        if not args.json:
            print(f"recorded {cassette_path}")

    if args.json:
        print(json.dumps(results, indent=2))
    return 0


def _print_gen_human(report: dict) -> None:
    print(f"konjo-eval gen: {report['n_fixtures']} generation fixture(s)")
    for fx in report["fixtures"]:
        counts = (
            ", ".join(f"{c}={n}" for c, n in fx["counts"].items() if n)
            or "no mechanically-classified findings"
        )
        print(f"  [{fx['context_label']}] {fx['id']}: {counts}")
    print("  totals: " + ", ".join(f"{c}={n}" for c, n in report["totals"].items()))
    if report["unclassified_classes"]:
        print(
            "  NOT mechanically classified by this harness (needs a review/human pass): "
            + ", ".join(report["unclassified_classes"])
        )
    print("konjo-eval gen: report-only, never blocks")


def _print_human(report: dict) -> None:
    print(
        f"konjo-eval: {report['summary']['n_fixtures']} fixtures, "
        f"runs={report['runs']}, mode={report['mode']}"
    )
    for fx in report["fixtures"]:
        mark = "PASS" if fx["passed"] else "FAIL"
        detail = (
            f"detection_rate={fx['detection_rate']} per_run={fx['per_run_detected']}"
            if fx["kind"] == "must_flag"
            else f"silent_runs={fx['per_run_detected']} findings={fx['per_run_findings']}"
        )
        print(f"  [{mark}] {fx['name']} ({fx['kind']}) {detail}")
    s = report["summary"]
    if s["missed_bugs"]:
        print(f"  missed bugs: {', '.join(s['missed_bugs'])}")
    if s["false_positive_controls"]:
        print(f"  controls that fired: {', '.join(s['false_positive_controls'])}")
    print(f"konjo-eval: {'OK' if report['ok'] else 'REGRESSION'}")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="konjo-eval")
    parser.add_argument("cmd", nargs="?", default="run", choices=["run", "record", "gen", "genrun"])
    parser.add_argument("--profile", default=str(_KIBAN_ROOT / "profiles" / "squish.yml"))
    parser.add_argument("--runs", type=int, default=runner.DEFAULT_RUNS)
    parser.add_argument("--mode", default="daily", choices=["daily", "deep"])
    parser.add_argument("--corpus", default=None)
    parser.add_argument(
        "--replay", action="store_true", help="force the deterministic replay backend (the CI path)"
    )
    parser.add_argument("--live", action="store_true", help="force the live Claude CLI backend")
    parser.add_argument("--json", action="store_true", help="emit the raw report as JSON")
    parser.add_argument("--tasks", default=None, help="genrun: path to a task spec JSON file")
    parser.add_argument(
        "--context-file",
        default=None,
        help="genrun: file whose content is passed as --append-system-prompt",
    )
    parser.add_argument("--model", default=None, help="genrun: model override")
    parser.add_argument(
        "--out-dir",
        default=None,
        help="genrun: save each successful run as a fixture under this dir",
    )
    parser.add_argument(
        "--record",
        action="store_true",
        help="genrun: wrap the live backend and save a cassette after",
    )
    args = parser.parse_args(argv)

    if args.cmd == "genrun":
        if not args.tasks:
            parser.error("genrun requires --tasks TASKS.json")
        return _run_genrun(args)

    if args.cmd == "gen":
        gen_corpus = pathlib.Path(args.corpus) if args.corpus else genfixtures.GEN_FIXTURES_DIR
        report = genfixtures.run_gen_corpus(gen_corpus)
        if args.json:
            print(json.dumps(report, indent=2))
        else:
            _print_gen_human(report)
        return 0  # report-only: never blocks, regardless of counts

    corpus = pathlib.Path(args.corpus) if args.corpus else runner.FIXTURES_DIR

    if args.cmd == "record":
        written = runner.record_cassettes(args.profile, mode=args.mode, corpus_dir=corpus)
        for p in written:
            print(f"recorded {p}")
        return 0

    # Default behavior: deterministic replay when cassettes exist; live only when there
    # are no cassettes or --live is given. --replay forces replay (errors if missing).
    backend: ReviewBackend | None
    use_replay = args.replay or (not args.live and cassettes.cassettes_present())
    if use_replay:
        backend = cassettes.ReplayBackend(cassettes.load_cassettes())
    else:
        backend = None  # runner builds the live ClaudeCLIBackend

    report = runner.run(
        args.profile, runs=args.runs, backend=backend, mode=args.mode, corpus_dir=corpus
    )

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(f"konjo-eval: backend={'replay' if use_replay else 'live'}")
        _print_human(report)

    return 0 if report["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
